# First NexOS NetSurf milestone configuration.
# This file is copied into the locked upstream netsurf source tree by the
# eventual port build. Features not needed for an HTML/CSS/PNG page stay off.

override NETSURF_USE_CURL := NO
override NETSURF_USE_OPENSSL := NO
override NETSURF_USE_NEXOS := YES
CFLAGS += -DWITH_NEXOS -I../../../../
override NETSURF_USE_PNG := YES
override NETSURF_USE_JPEG := NO
override NETSURF_USE_GIF := NO
override NETSURF_USE_BMP := NO
override NETSURF_USE_JPEGXL := NO
override NETSURF_USE_WEBP := NO
override NETSURF_USE_NSSVG := NO
override NETSURF_USE_ROSPRITE := NO
override NETSURF_USE_DUKTAPE := NO
override NETSURF_USE_HARU_PDF := NO
override NETSURF_USE_NSPSL := NO
override NETSURF_USE_NSLOG := NO
override NETSURF_USE_UTF8PROC := NO
override NETSURF_FB_FONTLIB := internal

# The NexOS build will replace these hosted libraries with port adapters.
# They remain enabled here to keep the upstream host probe honest.
